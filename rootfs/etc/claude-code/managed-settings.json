{
  "hooks": {
    "SessionStart": [
      {"matcher": "startup|resume", "hooks": [{"type": "command", "command": "/usr/local/lib/ccdash/hooks/state.sh waiting"}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "/usr/local/lib/ccdash/hooks/state.sh ended"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "/usr/local/lib/ccdash/hooks/state.sh working"}]}
    ],
    "PostToolUse": [
      {"hooks": [{"type": "command", "command": "/usr/local/lib/ccdash/hooks/state.sh working"}]}
    ],
    "Notification": [
      {"matcher": "permission_prompt", "hooks": [{"type": "command", "command": "/usr/local/lib/ccdash/hooks/state.sh needs_approval"}]},
      {"matcher": "idle_prompt", "hooks": [{"type": "command", "command": "/usr/local/lib/ccdash/hooks/state.sh waiting"}]}
    ],
    "PermissionRequest": [
      {"hooks": [{"type": "command", "command": "/usr/local/lib/ccdash/hooks/permission.sh", "timeout": 150}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "/usr/local/lib/ccdash/hooks/state.sh waiting"}]}
    ],
    "StopFailure": [
      {"hooks": [{"type": "command", "command": "/usr/local/lib/ccdash/hooks/state.sh error"}]}
    ]
  },
  "statusLine": {"type": "command", "command": "/usr/local/lib/ccdash/hooks/statusline.sh"},
  "permissions": {"allow": ["mcp__basic-memory"], "deny": ["Bash(tmux:*)"]}
}
