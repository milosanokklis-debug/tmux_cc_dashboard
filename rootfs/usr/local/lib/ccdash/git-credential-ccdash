#!/usr/bin/env bash
[ "${1:-}" = get ] || exit 0
host='' path='' protocol=''
while IFS='=' read -r k v; do
  [ -n "$k" ] || break
  case "$k" in host) host=$v ;; path) path=$v ;; protocol) protocol=$v ;; esac
done
[ "$protocol" = https ] || exit 0
[ "$host" = github.com ] || exit 0
owner=${path%%/*}
[[ $owner =~ ^[A-Za-z0-9-]+$ ]] || exit 0
f=${CCDASH_GIT_DIR:-/var/lib/ccdash-git}/$owner
[ -r "$f" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$f")"
