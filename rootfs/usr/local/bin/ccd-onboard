#!/usr/bin/env bash
# ccd-onboard <owner/repo>: clone, or pull when the folder is already that repo, then record
# {repo, head, ts} in $CCDASH_PROJECTS/<project>.json (existing keys are kept).
set -euo pipefail
WS=${CCDASH_WS:-/workspace} # overridden only by the tests
PROJECTS=${CCDASH_PROJECTS:-$HOME/.ccdash/projects}
[ $# -eq 1 ] || { echo "usage: ccd-onboard <owner/repo>" >&2; exit 2; }
repo=$1
if ! [[ $repo =~ ^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || [[ $repo == *..* ]] || [[ ${repo#*/} == .* ]]; then
  echo "invalid repo" >&2; exit 2
fi
proj=${repo#*/}
dir=$WS/$proj
cp=$(dirname "$0")/ccd-project
if [ -e "$dir/.git" ]; then
  origin=$(git -C "$dir" config --get remote.origin.url 2>/dev/null || true)
  norm=${origin%/}; norm=${norm%.git}; norm=${norm%/}
  want=$(printf 'https://github.com/%s' "$repo")
  if [ "${norm,,}" != "${want,,}" ]; then echo "$dir belongs to a different repo" >&2; exit 3; fi
  if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
    echo "uncommitted changes in $proj; commit or stash first" >&2; exit 3
  fi
  "$cp" pull "$proj"
else
  "$cp" clone "$repo"
fi
head=$(git -C "$dir" rev-parse HEAD)
umask 027
mkdir -p "$PROJECTS" # umask 027 makes new directories 750
f=$PROJECTS/$proj.json
cur=$(jq -c 'if type == "object" then . else {} end' "$f" 2>/dev/null) || cur='{}'
[ -n "$cur" ] || cur='{}'
tmp=$f.tmp.$$
jq -cn --argjson cur "$cur" --arg repo "$repo" --arg head "$head" --argjson ts "$(date +%s)" \
  '$cur + {repo: $repo, head: $head, ts: $ts}' > "$tmp"
mv "$tmp" "$f"
echo "head $head"
