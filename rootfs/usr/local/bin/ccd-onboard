#!/usr/bin/env bash
# ccd-onboard [--trust-hooks] <owner/repo>: clone, or pull when the folder is already that repo, then record
# {repo, head, ts[, trustHooks]} (no head for an empty repo) in $CCDASH_PROJECTS/<project>.json (existing keys are kept).
set -euo pipefail
WS=${CCDASH_WS:-/workspace} # overridden only by the tests
PROJECTS=${CCDASH_PROJECTS:-$HOME/.ccdash/projects}
# A repo that defines hooks in .claude/settings*.json is refused (exit 5, "hooks: <names>" on stdout)
# unless --trust-hooks is given or an earlier onboarding was trusted (trustHooks in the record).
trust=0
if [ "${1:-}" = --trust-hooks ]; then trust=1; shift; fi
[ $# -eq 1 ] || { echo "usage: ccd-onboard [--trust-hooks] <owner/repo>" >&2; exit 2; }
repo=$1
if ! [[ $repo =~ ^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || [[ $repo == *..* ]] || [[ ${repo#*/} == .* ]]; then
  echo "invalid repo" >&2; exit 2
fi
proj=${repo#*/}
dir=$WS/$proj
cp=$(dirname "$0")/ccd-project
rec=$PROJECTS/$proj.json
if [ "$trust" = 0 ] && [ -e "$dir/.git" ] && [ "$(jq -r '.trustHooks // false' "$rec" 2>/dev/null || true)" = true ]; then trust=1; fi
CCDASH_TRUST_HOOKS=$trust
export CCDASH_TRUST_HOOKS
if [ -e "$dir/.git" ]; then
  origin=$(git -C "$dir" config --get remote.origin.url 2>/dev/null || true)
  norm=${origin%/}; norm=${norm%.git}; norm=${norm%/}
  want=$(printf 'https://github.com/%s' "$repo")
  if [ "${norm,,}" != "${want,,}" ]; then echo "$dir belongs to a different repo" >&2; exit 3; fi
  "$cp" pull "$proj"
else
  "$cp" clone "$repo"
fi
head=$(git -C "$dir" rev-parse --verify -q HEAD || true) # empty for an unborn HEAD (empty repo)
umask 027
mkdir -p "$PROJECTS" # umask 027 makes new directories 750
cur=$(jq -c 'if type == "object" then . else {} end' "$rec" 2>/dev/null) || cur='{}'
[ -n "$cur" ] || cur='{}'
tmp=$rec.tmp.$$
jq -cn --argjson cur "$cur" --arg repo "$repo" --arg head "$head" --argjson ts "$(date +%s)" --argjson trust "$trust" \
  '$cur + {repo: $repo, ts: $ts} | if $head == "" then del(.head) else .head = $head end
   | if $trust == 1 then .trustHooks = true else . end' > "$tmp"
mv "$tmp" "$rec"
[ -z "$head" ] || echo "head $head"
