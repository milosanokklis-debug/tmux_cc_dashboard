#!/usr/bin/env bash
set -euo pipefail
WS=${CCDASH_WS:-/workspace} # overridden only by the tests
# shellcheck source=/dev/null
. "${CCDASH_ACCOUNTS_LIB:-/usr/local/lib/ccdash}/accounts.sh"
t() { tmux -S "${CCDASH_TMUX:-/run/ccdash/tmux.sock}" "$@"; }
name_for() { local b=${1##*/}; printf 'claude-%s' "${b//[^[:alnum:]_-]/_}"; }
# `--` ends option parsing so a prompt beginning with "-" is never read as a claude flag
# (checked against claude 2.1.317: `claude -p -- "-x"` treats "-x" as the prompt).
cmd=(bash -lc 'claude -- "$@"; exec bash -l' _)
# tmux reads an argument ending in ';' as the end of the command and drops it; `\;` at the end
# means a literal ';' (so `x;` becomes `x\;` and `x\;` becomes `x\\;`). Checked against tmux 3.5a.
# An empty prompt is dropped (same as the web path) instead of being passed on as "".
tmux_args() { local a; targs=(); for a in "$@"; do [ -n "$a" ] || continue; [[ $a == *';' ]] && a="${a%;}\\;"; targs+=("$a"); done; }
# Start gate: Basic Memory must be registered and connected before a Claude is launched. Exit 7 and
# `memory offline` + the `claude mcp list` output on stderr otherwise. Only the real entry counts: a line that
# starts with `basic-memory: ` (exact server name) and ends with ` - [✓] Connected`. Anything else at the end
# ("Failed to connect", "Disconnected", "Not connected", "Needs authentication", "Pending") is refused.
mcp_gate() {
  local out l status
  out=$( (account_env "$1" && timeout "${CCDASH_MCP_TIMEOUT:-20}" claude mcp list 2>&1 </dev/null) || true)
  while IFS= read -r l; do
    [[ $l == 'basic-memory: '* && $l == *' - '* ]] || continue
    status=${l##* - }
    status=${status#✓}; status=${status#✔}; status=${status# }
    [ "$status" = Connected ] && return 0
  done <<<"$out"
  { echo "memory offline"; printf '%s\n' "$out"; } >&2
  exit 7
}
# Prints the project's tmux session name, creating the session if it is missing. $1 project,
# $2 dir, $3 "window" to always add a window when the session exists (wake), $4 account, then the
# command to run. With the default mode a live session gets a new window only for an account that has
# none yet. Windows carry the account in the window option @account (none counts as default).
launch() {
  local proj=$1 dir=$2 mode=$3 acct=$4 name existing cdir wid a have=0
  local -a env=()
  shift 4
  cdir=$(account_config_dir "$acct")
  [ -z "$cdir" ] || env=(-e "CLAUDE_CONFIG_DIR=$cdir")
  name=$(name_for "$proj")
  if t has-session -t "=$name" 2>/dev/null; then
    # name_for is lossy (a.b and a_b collide): never attach one project to another's session
    existing=$(t show-options -qv -t "=$name:" @project_dir 2>/dev/null || true)
    if [ -z "$existing" ]; then
      # another start may sit between new-session and set; retry once
      sleep 0.3
      existing=$(t show-options -qv -t "=$name:" @project_dir 2>/dev/null || true)
    fi
    if [ "$existing" != "$dir" ]; then
      echo "session name $name is already used by ${existing:-another project}; rename the project" >&2
      exit 1
    fi
    if [ "$mode" != window ]; then
      while read -r _ a; do
        [ "${a:-default}" = "$acct" ] && have=1
      done < <(t list-windows -t "=$name:" -F '#{window_id} #{@account}' 2>/dev/null || true)
    fi
    # a start on an account that already has a window launches nothing, so it needs no gate
    if [ "$have" = 0 ]; then
      mcp_gate "$acct"
      wid=$(t new-window -P -F '#{window_id}' -t "=$name:" -c "$dir" ${env[@]+"${env[@]}"} "$@")
      t set -w -t "$wid" @account "$acct"
    fi
  else
    mcp_gate "$acct"
    t new-session -d -s "$name" -c "$dir" ${env[@]+"${env[@]}"} "$@"
    t set -t "=$name:" @project_dir "$dir"
    t set -w -t "=$name:" @account "$acct"
  fi
  echo "$name"
}
# split_account <args...>: sets acct and rest[] from leading `--account NAME`.
# Only that position is read; everything else (a prompt, even one starting with "-") stays in rest.
split_account() {
  acct=default
  if [ "${1:-}" = --account ]; then
    [ $# -ge 2 ] || { echo "--account needs a name" >&2; exit 2; }
    acct=$2; shift 2
  fi
  account_valid "$acct" || { echo "invalid account name: $acct" >&2; exit 2; }
  rest=("$@")
}
# known_account NAME: `default` or an existing real directory (not a symlink) under the accounts dir.
known_account() {
  local d
  [ "$1" = default ] && return 0
  d=$(account_config_dir "$1")
  [ -d "$d" ] && [ ! -L "$d" ] || { echo "unknown account: $1 (create it with: ccd login --account $1)" >&2; exit 1; }
}
usage() { echo "usage: ccd-session start <project> [--account name] [prompt] | wake <session-id> | attach <project> [--account name] | ls" >&2; exit 2; }

sub=${1:-}
[ $# -gt 0 ] && shift
case "$sub" in
  start)
    [ $# -ge 1 ] || usage
    proj=$1; shift
    [[ $proj =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] && [[ $proj != *..* ]] || { echo "invalid project name" >&2; exit 2; }
    dir=$WS/$proj
    [ -d "$dir" ] || { echo "no such project: $proj" >&2; exit 1; }
    split_account "$@"
    known_account "$acct"
    tmux_args ${rest[@]+"${rest[@]}"}
    launch "$proj" "$dir" keep "$acct" "${cmd[@]}" ${targs[@]+"${targs[@]}"}
    ;;
  wake)
    # Resumes a stopped conversation (claude --resume) in the project's tmux session. The old state
    # record is replaced by the new conversation (CCDASH_RESUMED_FROM). The caller checks liveness.
    [ $# -eq 1 ] || usage
    sid=$1
    [[ $sid =~ ^[0-9a-f-]{36}$ ]] || { echo "invalid session id" >&2; exit 2; }
    rec=${CCDASH_STATE:-/home/ccd/.ccdash/sessions}/$sid.json
    [ -f "$rec" ] || { echo "no such conversation" >&2; exit 1; }
    dir=$(jq -r '.project // empty' "$rec" 2>/dev/null || true)
    if [[ $dir != "$WS"/* ]] || [[ $dir == *..* ]] || [ ! -d "$dir" ]; then
      echo "conversation project is not an existing directory under $WS" >&2
      exit 1
    fi
    acct=$(jq -r '.account // "default"' "$rec" 2>/dev/null || echo default)
    account_valid "$acct" || { echo "conversation account is invalid: $acct" >&2; exit 1; }
    known_account "$acct"
    rel=${dir#"$WS"/}
    proj=${rel%%/*}
    [[ $proj =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || { echo "invalid project name" >&2; exit 1; }
    # --resume goes before any `--`; the id was validated above. CCDASH_RESUMED_FROM is set for the
    # claude process only, so later windows of the same tmux session do not inherit it.
    # shellcheck disable=SC2016 # $1 is expanded by the inner bash, on purpose
    launch "$proj" "$WS/$proj" window "$acct" bash -lc 'CCDASH_RESUMED_FROM="$1" claude --resume "$1"; exec bash -l' _ "$sid"
    ;;
  attach)
    [ $# -eq 1 ] || { [ $# -eq 3 ] && [ "$2" = --account ]; } || usage
    name=$("$0" start "$@")
    if [ -n "${TMUX:-}" ]; then
      t switch-client -t "=$name"
    else
      t attach -t "=$name"
    fi
    ;;
  ls)
    out=$(t list-sessions -F '#{session_name}' 2>/dev/null | grep '^claude-' || true)
    if [ -n "$out" ]; then printf '%s\n' "$out"; else echo "no sessions"; fi
    ;;
  *) usage ;;
esac
