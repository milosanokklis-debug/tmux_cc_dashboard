#!/usr/bin/env bash
set -euo pipefail
WS=${CCDASH_WS:-/workspace} # overridden only by the tests
export GIT_TERMINAL_PROMPT=0
# Hook trust (Phase F speed bump): a repo whose .claude/settings.json or settings.local.json defines hooks or
# another code-running/credential setting (apiKeyHelper, env, mcpServers, ...), or that has .mcp.json, or whose
# settings are symlinks or unparseable, is refused (exit 5, a `hooks: <name,name>` line) unless
# CCDASH_TRUST_HOOKS=1 (ccd-onboard sets it from --trust-hooks or the project record). Only names are printed.
# Agent-kit exemption (Phase H): `ccd-onboard` runs the kit, which commits .claude/settings.json with enabledPlugins
# and extraKnownMarketplaces. Those two keys are not flagged only when ALL hold: .claude/agent-kit.json is a regular
# file (not a symlink) in the same tree that parses as a JSON object with a string kit_version; every marketplace is
# a github source (no other fields) whose repo is $KIT_REPO (set by ccd-onboard) or one of the kit's pinned upstream
# marketplaces; and every enabledPlugins key is exactly one the kit writes, set to true: kit-core, kit-design,
# kit-code, taste-skill @ the marketplace whose repo is $KIT_REPO, or one of the upstream plugins the kit depends on
# (agent-skills, superpowers, hallmark, design-and-refine) @ its own marketplace, which must also be listed.
# Only .claude/settings.json is exempt (never settings.local.json); hooks, env, mcpServers etc. are still flagged.
KIT_REPO=${KIT_REPO:-}
kit_manifest_ok() { # kit_manifest_ok <json text>: an object with a string kit_version
  jq -e 'type == "object" and (.kit_version | type == "string")' <<< "$1" > /dev/null 2>&1
}
settings_flags() { # settings_flags <json text> [kit_ok 0|1]: comma-separated hook events and risky key names; empty when clean
  jq -r --argjson kit "${2:-0}" --arg kr "$KIT_REPO" 'def nonempty: . != null and . != false and . != "" and . != [] and . != {};
    def upstream: ["addyosmani/agent-skills","obra/superpowers-marketplace","mattpocock/skills","nutlope/hallmark","0xdesign/design-plugin"];
    def okrepo: ascii_downcase as $r | ($kr != "" and $r == ($kr | ascii_downcase)) or (upstream | index($r) != null);
    def kitmk: .extraKnownMarketplaces | type == "object" and length > 0 and all(.[]; type == "object" and keys == ["source"]
      and (.source | type == "object" and keys == ["repo","source"] and .source == "github" and (.repo | type == "string" and okrepo)));
    def upkeys: ["agent-skills@addy-agent-skills","superpowers@superpowers-marketplace","hallmark@hallmark","design-and-refine@design-plugins"];
    def kitkeys: [.extraKnownMarketplaces | to_entries[] | select($kr != "" and (.value.source.repo | ascii_downcase) == ($kr | ascii_downcase))
      | .key as $n | ("kit-core","kit-design","kit-code","taste-skill") + "@" + $n];
    def kitep: ((.extraKnownMarketplaces | objects | keys) // []) as $mk | (kitkeys + upkeys) as $ok
      | (.enabledPlugins | type == "object" and length > 0 and all(to_entries[]; .key as $k | .value == true
          and ($ok | index($k) != null) and ($mk | index($k | split("@")[1]) != null)));
    [ (if (.hooks | type) == "object" then (.hooks | keys | map(gsub("[^A-Za-z0-9_]"; "?"))[])
       elif (.hooks | nonempty) then "(unrecognised hooks value)" else empty end),
      (["apiKeyHelper","awsAuthRefresh","awsCredentialExport","otelHeadersHelper","env","enabledPlugins","extraKnownMarketplaces","mcpServers"][] as $k
        | select(.[$k] | nonempty)
        | select(($k == "extraKnownMarketplaces" and $kit == 1 and kitmk) | not)
        | select(($k == "enabledPlugins" and $kit == 1 and kitmk and kitep) | not) | $k) ] | join(",")' <<< "$1" 2> /dev/null || echo "(unparseable settings)"
}
refuse_hooks() { # refuse_hooks <names...>: print the union and exit 5
  local ev; ev=$(printf '%s\n' "$@" | tr ',' '\n' | sed '/^$/d' | sort -u | paste -sd, -)
  [ -n "$ev" ] || return 0
  echo "this repo defines hooks or other trusted settings ($ev); onboard it with --trust-hooks (UI: \"I trust this repo's hooks\") if you trust it" >&2
  echo "hooks: $ev"
  exit 5
}
usage() { echo "usage: ccd-project clone <owner/repo> | pull <project>" >&2; exit 2; }
[ $# -eq 2 ] || usage
case $1 in clone | pull) ;; *) usage ;; esac
if [ "$1" = pull ]; then
  proj=$2
  if ! [[ $proj =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || [[ $proj == *..* ]]; then
    echo "invalid project name" >&2; exit 2
  fi
  dir=$WS/$proj
  if [ ! -e "$dir/.git" ]; then echo "$proj is not a git checkout" >&2; exit 3; fi
  if ! status=$(git -C "$dir" status --porcelain 2>&1); then echo "$proj is not a git checkout" >&2; exit 3; fi
  if [ -n "$status" ]; then echo "uncommitted changes in $proj; commit or stash first" >&2; exit 3; fi
  origin=$(git -C "$dir" config --get remote.origin.url 2>/dev/null || true)
  norm=${origin%/}; norm=${norm%.git}; norm=${norm%/}
  if ! [[ ${norm,,} =~ ^https://github\.com/[a-z0-9][a-z0-9-]*/${proj,,}$ ]]; then
    echo "$dir has a different origin" >&2; exit 3
  fi
  branch=$(git -C "$dir" symbolic-ref -q --short HEAD || true)
  if [ -n "$branch" ]; then
    remote=$(git -C "$dir" config --get "branch.$branch.remote" 2>/dev/null || true)
    if [ -n "$remote" ] && [ "$remote" != origin ]; then
      echo "$proj tracks remote $remote, not origin; resolve it in a shell" >&2; exit 3
    fi
  fi
  old=$(git -C "$dir" rev-parse --verify -q HEAD || true) # empty for an unborn HEAD
  if ! out=$(git -C "$dir" fetch --quiet origin 2>&1 < /dev/null); then
    echo "could not reach the remote: $(printf '%s\n' "$out" | head -n 1)" >&2; exit 4
  fi
  if ! up=$(git -C "$dir" rev-parse --verify --quiet '@{u}' 2>/dev/null); then
    if [ -z "$old" ]; then echo "nothing to pull yet; origin has no commits on this branch"; exit 0; fi
    echo "$proj has no upstream branch; resolve it in a shell" >&2; exit 3
  fi
  if [ "${CCDASH_TRUST_HOOKS:-}" != 1 ] && [ "$up" != "$old" ]; then # what the merge would bring in
    ev=(); kit_ok=0; entries=()
    while read -r mode _ _ path; do # symlinks would make `git show` print the link target
      entries+=("$mode $path")
      if [ "$path" = .claude/agent-kit.json ] && [ "$mode" = 100644 ] && kit_manifest_ok "$(git -C "$dir" show "$up:$path" 2> /dev/null)"; then kit_ok=1; fi
    done < <(git -C "$dir" ls-tree "$up" .claude .claude/settings.json .claude/settings.local.json .claude/agent-kit.json .mcp.json 2> /dev/null)
    for e in "${entries[@]}"; do
      mode=${e%% *}; path=${e#* }
      case $path in
        .mcp.json) ev+=(".mcp.json") ;;
        .claude/agent-kit.json) ;;
        *) if [ "$mode" = 120000 ]; then ev+=("(symlink)")
           elif [ "$mode" != 040000 ]; then
             ok=0; [ "$path" = .claude/settings.json ] && ok=$kit_ok
             ev+=("$(settings_flags "$(git -C "$dir" show "$up:$path" 2> /dev/null)" "$ok")")
           fi ;;
      esac
    done
    refuse_hooks "${ev[@]}"
  fi
  [ -z "$old" ] || echo "old ${old:0:7}"
  if [ -z "$old" ] || { [ "$up" != "$old" ] && git -C "$dir" merge-base --is-ancestor "$old" "$up"; }; then
    git -C "$dir" merge --ff-only --quiet "$up" > /dev/null
    echo "pulled"
  elif [ "$up" = "$old" ]; then
    echo "already up to date"
  elif git -C "$dir" merge-base --is-ancestor "$up" "$old"; then
    echo "ahead of origin; nothing to pull"
  else
    # Diverged. Only local commits that ccdash itself made (the agent-kit commits: author ccdash@localhost, touching
    # only .claude/ and CLAUDE.md, no merges) are rebased onto origin; anything else is left for a shell.
    ours=1
    if [ -n "$(git -C "$dir" rev-list --merges "$up..HEAD")" ]; then ours=0; fi
    while read -r c; do
      [ "$ours" = 1 ] || break
      [ "$(git -C "$dir" log -1 --format=%ae "$c")" = ccdash@localhost ] || { ours=0; break; }
      while read -r f; do
        case $f in .claude/* | CLAUDE.md) ;; *) ours=0; break ;; esac
      done < <(git -C "$dir" diff-tree --no-commit-id --name-only -r "$c")
    done < <(git -C "$dir" rev-list "$up..HEAD")
    if [ "$ours" = 0 ]; then
      echo "$proj has diverged from origin; resolve it in a shell (local commits not from ccdash)" >&2; exit 3
    fi
    if ! git -C "$dir" -c user.name=ccdash -c user.email=ccdash@localhost -c core.hooksPath=/dev/null rebase --quiet "$up" > /dev/null 2>&1 < /dev/null; then
      git -C "$dir" rebase --abort > /dev/null 2>&1 || true
      echo "rebase failed" >&2; exit 3
    fi
    echo "rebased"
    echo "pulled"
  fi
  head=$(git -C "$dir" rev-parse --verify -q HEAD || true)
  [ -z "$head" ] || echo "head $head"
  exit 0
fi
repo=$2
if ! [[ $repo =~ ^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || [[ $repo == *..* ]] || [[ ${repo#*/} == .* ]]; then
  echo "invalid repo" >&2; exit 2
fi
name=${repo#*/}
dest=$WS/$name
if [ -d "$dest" ]; then
  origin=$(git -C "$dest" config --get remote.origin.url 2>/dev/null || true)
  norm=${origin%.git}; norm=${norm%/}
  if [ "${norm,,}" = "$(printf 'https://github.com/%s' "$repo" | tr '[:upper:]' '[:lower:]')" ]; then
    echo "already cloned"
    head=$(git -C "$dest" rev-parse --verify -q HEAD || true)
    [ -z "$head" ] || echo "head $head"
    exit 0
  fi
  echo "$dest exists with a different origin" >&2; exit 3
fi
git clone -- "https://github.com/$repo.git" "$dest"
if [ "${CCDASH_TRUST_HOOKS:-}" != 1 ]; then # nothing has run in the clone yet; remove it (it did not exist before)
  ev=()
  [ ! -e "$dest/.mcp.json" ] && [ ! -L "$dest/.mcp.json" ] || ev+=(".mcp.json")
  if [ -L "$dest/.claude" ]; then ev+=("(symlink)"); else
    for f in settings.json settings.local.json; do
      if [ -L "$dest/.claude/$f" ]; then ev+=("(symlink)")
      elif [ -f "$dest/.claude/$f" ]; then
        ok=0; [ "$f" = settings.json ] && [ -f "$dest/.claude/agent-kit.json" ] && [ ! -L "$dest/.claude/agent-kit.json" ] \
          && kit_manifest_ok "$(< "$dest/.claude/agent-kit.json")" && ok=1
        ev+=("$(settings_flags "$(< "$dest/.claude/$f")" "$ok")")
      fi
    done
  fi
  if [ -n "$(printf '%s' "${ev[@]}")" ]; then rm -rf "$dest"; refuse_hooks "${ev[@]}"; fi
fi
head=$(git -C "$dest" rev-parse --verify -q HEAD || true)
[ -z "$head" ] || echo "head $head"
