#!/bin/bash
# Fake `claude` REPL for tests: reads prompts from stdin and, on cues, runs the hooks configured
# in a settings file with fixture payloads. See tests/fake-claude/README.md.
# The shebang is /bin/bash, not `env bash`: with env the process is named "bash", and the dashboard
# finds Claude by the process name "claude".
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
fixtures=${FAKE_CLAUDE_FIXTURES:-}
if [ -z "$fixtures" ]; then
  if [ -d /usr/local/share/fake-claude/fixtures ]; then fixtures=/usr/local/share/fake-claude/fixtures
  else fixtures=$here/../fixtures/2.1.317; fi
fi
settings=${FAKE_CLAUDE_SETTINGS:-/etc/claude-code/managed-settings.json}
tmo=${FAKE_CLAUDE_TIMEOUT:-5}
# `claude mcp ...` (no REPL). FAKE_CLAUDE_MCP picks what `mcp list` shows: connected (default),
# disconnected (a trap: "Disconnected" is not the real wording, and must not pass the gate), failed
# (the real "Failed to connect") or none (no servers). `mcp add` appends its argv to $fhome/mcp-add.log
# and, unless FAKE_CLAUDE_MCP=none is overridden by a test, registers basic-memory for later lists.
if [ "${1:-}" = mcp ]; then
  mhome=${FAKE_CLAUDE_HOME:-${HOME:-/tmp}/.fake-claude}
  [ -z "${CLAUDE_CONFIG_DIR:-}" ] || mhome=$mhome/accounts/$(basename "$CLAUDE_CONFIG_DIR") # per-account state
  mkdir -p "$mhome"
  case ${2:-} in
    list)
      echo "Checking MCP server health..."
      echo
      bm=/opt/basic-memory/bin/basic-memory
      registered=${FAKE_CLAUDE_MCP:-connected}
      [ -f "$mhome/mcp-registered" ] && [ "$registered" = none ] && registered=connected
      case $registered in
        connected) echo "basic-memory: $bm mcp - $(printf '\342\234\223') Connected" ;;
        disconnected) echo "basic-memory: $bm mcp - $(printf '\342\234\227') Disconnected" ;;
        failed) echo "basic-memory: $bm mcp - $(printf '\342\234\227') Failed to connect" ;;
        none) echo "No MCP servers configured. Use \`claude mcp add\` to add a server." ;;
      esac
      ;;
    add) printf '%s\n' "$*" >>"$mhome/mcp-add.log"; : >"$mhome/mcp-registered"; echo "Added stdio MCP server ${3:-}" ;;
    *) echo "fake-claude: unsupported mcp command: $*" >&2; exit 2 ;;
  esac
  exit 0
fi

# `claude auth status`: logged in (exit 0) only if $mhome/logged-in exists; state is per CLAUDE_CONFIG_DIR as for mcp.
if [ "${1:-}" = auth ] && [ "${2:-}" = status ]; then
  mhome=${FAKE_CLAUDE_HOME:-${HOME:-/tmp}/.fake-claude}
  [ -z "${CLAUDE_CONFIG_DIR:-}" ] || mhome=$mhome/accounts/$(basename "$CLAUDE_CONFIG_DIR")
  if [ -f "$mhome/logged-in" ]; then echo '{"loggedIn": true}'; exit 0; fi
  echo '{"loggedIn": false}'
  exit 1
fi

sid=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen)
fhome=${FAKE_CLAUDE_HOME:-${HOME:-/tmp}/.fake-claude}
mkdir -p "$fhome/history" "$fhome/prompts"
events=$fhome/events.log
event() { printf '%s\n' "$1" >>"$events"; } # one line per notable event, for tests
export CLAUDE_PROJECT_DIR=${CLAUDE_PROJECT_DIR:-$PWD}

source=startup resume_id=
printf '%s\n' "$*" >>"$fhome/args.log" # every start is recorded, so tests can check --resume <id>
prev=
for a in "$@"; do
  case $a in --resume | --continue | -r | -c) source=resume ;; esac
  case $prev in --resume | -r) [[ $a =~ ^[0-9a-f-]{36}$ ]] && resume_id=$a ;; --settings) settings=$a ;; esac
  prev=$a
done
hist=$fhome/history/$sid
: >"$hist"
if [ -n "$resume_id" ]; then # replay the old conversation's history, as the real --resume does
  echo "resumed $resume_id"
  if [ -f "$fhome/history/$resume_id" ]; then
    cat "$fhome/history/$resume_id" >"$hist"
    while IFS= read -r l; do echo "history: $l"; done <"$hist"
  fi
fi

# Transcripts (off unless FAKE_CLAUDE_TRANSCRIPTS=<dir>): <dir>/<cwd with / and . as ->/<sid>.jsonl,
# like Claude Code's projects/ layout. Payloads then carry that transcript_path, every prompt appends
# a user line and an assistant line (written twice, as Claude does per content block; usage from
# FAKE_CLAUDE_USAGE="input output cache_creation cache_read", default "10 20 30 40", model from
# FAKE_CLAUDE_MODEL, default claude-sonnet-5-5), and /sub writes <sid>/subagents/agent-<id>.jsonl.
tdir=${FAKE_CLAUDE_TRANSCRIPTS:-}
tproj=
tfile=
if [ -n "$tdir" ]; then
  tproj=$tdir/${PWD//[\/.]/-}
  tfile=$tproj/$sid.jsonl
  mkdir -p "$tproj/$sid/subagents"
  : >"$tfile"
fi
now_iso() { date -u +%Y-%m-%dT%H:%M:%S.000Z; }
# tline FILE ROLE ID TEXT -> one transcript line
tline() {
  local u in out cc cr
  read -r in out cc cr <<<"${FAKE_CLAUDE_USAGE:-10 20 30 40}"
  if [ "$2" = user ]; then
    jq -nc --arg ts "$(now_iso)" --arg t "$4" --arg sid "$sid" '{type: "user", timestamp: $ts, sessionId: $sid, message: {role: "user", content: $t}}' >>"$1"
  else
    u=$(jq -nc --argjson i "$in" --argjson o "$out" --argjson c "$cc" --argjson r "$cr" '{input_tokens: $i, output_tokens: $o, cache_creation_input_tokens: $c, cache_read_input_tokens: $r}')
    for _ in 1 2; do
      jq -nc --arg ts "$(now_iso)" --arg id "$3" --arg t "$4" --argjson u "$u" --arg m "${FAKE_CLAUDE_MODEL:-claude-sonnet-5-5}" \
        '{type: "assistant", timestamp: $ts, requestId: ("req_" + $id), message: {id: $id, model: $m, role: "assistant", content: [{type: "text", text: $t}], usage: $u}}' >>"$1"
    done
  fi
}

# payload NAME [JQ_FILTER] -> fixture JSON with session_id/cwd made real, then filter applied.
payload() {
  local f=$fixtures/$1.json tp='.'
  [ -f "$f" ] || { echo "fake-claude: missing fixture $f" >&2; return 1; }
  [ -n "$tfile" ] && tp='.transcript_path=env.FC_TFILE'
  FC_TFILE=$tfile jq -c --arg sid "$sid" --arg cwd "$PWD" ".session_id=\$sid | .cwd=\$cwd | $tp | ${2:-.}" "$f"
}

# hooks EVENT MATCH_VALUE -> command strings of matching hooks, one per line.
hook_cmds() {
  [ -f "$settings" ] || return 0
  jq -r --arg e "$1" --arg m "$2" '
    .hooks[$e][]?
    | select((.matcher // "") as $x | $x == "" or $x == "*" or ($m | test("^(" + $x + ")$")))
    | .hooks[]? | select(.type == "command") | "\(.timeout // "")\t\(.command)"' "$settings" 2>/dev/null
}

# run_hooks EVENT MATCH_VALUE JSON -> runs each hook with JSON on stdin; stdout passes through.
run_hooks() {
  local cmd rc t
  while IFS= read -r cmd; do
    [ -n "$cmd" ] || continue
    t=$tmo # a PermissionRequest hook runs with its own configured timeout (it may wait up to 150 s)
    if [ "$1" = PermissionRequest ] && [[ ${cmd%%$'\t'*} =~ ^[0-9]+$ ]]; then t=${cmd%%$'\t'*}; fi
    cmd=${cmd#*$'\t'}
    printf '%s' "$3" | timeout "$t" bash -c "$cmd"
    rc=$?
    [ "$rc" -eq 0 ] || echo "fake-claude: hook for $1 exited $rc" >&2
  done < <(hook_cmds "$1" "$2")
}

# fire EVENT FIXTURE MATCH_JQ_PATH [JQ_FILTER] -> run hooks, discard their stdout.
fire() {
  local json m
  json=$(payload "$2" "${4:-.}") || return 0
  m=$(jq -r "$3 // \"\"" <<<"$json")
  run_hooks "$1" "$m" "$json" >/dev/null
}

permission() {
  local json out decision ans msg
  json=$(payload PermissionRequest) || return 0
  out=$(run_hooks PermissionRequest "$(jq -r .tool_name <<<"$json")" "$json")
  decision=$(jq -rs '[.[] | .hookSpecificOutput.decision.behavior? // empty] | last // empty' <<<"$out" 2>/dev/null)
  case $decision in
    allow | deny)
      echo "permission: $decision"
      event "permission $decision"
      msg=$(jq -rs '[.[] | .hookSpecificOutput.decision.message? // empty] | last // empty' <<<"$out" 2>/dev/null)
      if [ -n "$msg" ]; then echo "permission-message: $msg"; event "permission-message: $msg"; fi
      ;;
    *)
      echo "fall-through: asking user"
      # A lone ESC (as tmux send-keys Escape) cancels the dialog and denies; otherwise the rest of the line follows.
      if IFS= read -rsn1 ans; then
        if [ "$ans" = $'\e' ]; then ans=esc; elif [ -n "$ans" ]; then IFS= read -r rest || true; ans=$ans$rest; fi
        case $ans in y | Y | yes) echo "permission: allow (user)"; event "permission allow (user)" ;; *) echo "permission: deny (user)"; event "permission deny (user)" ;; esac
      fi
      ;;
  esac
}

# FAKE_CLAUDE_RATE_LIMITS: "none" drops rate_limits from the /status payload (like an account whose
# statusLine has none); "<five_hour_pct> <seven_day_pct>" sets the two used percentages.
status() {
  local cmd json filt=.
  case ${FAKE_CLAUDE_RATE_LIMITS:-} in
    none) filt='del(.rate_limits)' ;;
    [0-9]*" "[0-9]*) filt=".rate_limits.five_hour.used_percentage=${FAKE_CLAUDE_RATE_LIMITS% *} | .rate_limits.seven_day.used_percentage=${FAKE_CLAUDE_RATE_LIMITS#* }" ;;
  esac
  json=$(payload statusline "$filt") || return 0
  cmd=$(jq -r '.statusLine.command // empty' "$settings" 2>/dev/null)
  if [ -n "$cmd" ]; then
    printf '%s' "$json" | timeout "$tmo" bash -c "$cmd"
    echo
  else
    jq -r '"\(.model.display_name) | 5h \(.rate_limits.five_hour.used_percentage // "?")% | 7d \(.rate_limits.seven_day.used_percentage // "?")%"' <<<"$json"
  fi
}

# /sub: SubagentStart then SubagentStop with a fresh agent id; with FAKE_CLAUDE_TRANSCRIPTS the
# subagent also gets its own transcript (SubagentStop carries agent_transcript_path, as the real one).
subagent() {
  local aid sf=
  aid=a$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')
  export FC_AID=$aid
  event "subagent $aid"
  fire SubagentStart SubagentStart .agent_type '.agent_id=env.FC_AID'
  if [ -n "$tfile" ]; then
    sf=$tproj/$sid/subagents/agent-$aid.jsonl
    tline "$sf" user "" "subagent task $aid"
    tline "$sf" assistant "msg_${aid}" "subagent reply"
    export FC_ATP=$sf
    fire SubagentStop SubagentStop .agent_type '.agent_id=env.FC_AID | .agent_transcript_path=env.FC_ATP'
  else
    fire SubagentStop SubagentStop .agent_type '.agent_id=env.FC_AID'
  fi
}

# /memsub: a subagent that writes and reads Basic Memory (PostToolUse for the two mcp tools, no permission request)
memsub() {
  local aid
  aid=a$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')
  export FC_AID=$aid
  fire SubagentStart SubagentStart .agent_type '.agent_id=env.FC_AID'
  fire PostToolUse PostToolUse .tool_name '.tool_name="mcp__basic-memory__bm_write"'
  fire PostToolUse PostToolUse .tool_name '.tool_name="mcp__basic-memory__bm_read"'
  fire SubagentStop SubagentStop .agent_type '.agent_id=env.FC_AID'
}

finish() {
  fire SessionEnd SessionEnd .reason
  exit 0
}

# long_turn -> blocks up to 120 s polling stdin. Returns 0 on a lone ESC (an interrupt), 1 on timeout
# or EOF. Everything else typed or pasted meanwhile is ignored, including bracketed pastes (ESC[200~
# ... ESC[201~) and other escape sequences, so a pasted /exit does not end the turn.
long_turn() {
  local end=$((SECONDS + 120)) c n seq rc
  echo "working..."
  while [ "$SECONDS" -lt "$end" ]; do
    IFS= read -rsn1 -t 0.2 c
    rc=$?
    [ "$rc" -gt 128 ] && continue
    [ "$rc" -eq 0 ] || return 1
    [ "$c" = $'\e' ] || continue
    IFS= read -rsn1 -t 0.25 n || return 0 # nothing follows the ESC: a real Esc key
    [ "$n" = "[" ] || continue
    seq=
    while IFS= read -rsn1 -t 0.1 n; do seq+=$n; [[ $n == [A-Za-z~] ]] && break; done
    if [ "$seq" = "200~" ]; then
      seq=
      while IFS= read -rsn1 -t 0.5 n; do seq+=$n; [[ $seq == *$'\e[201~' ]] && break; done
    fi
  done
  return 1
}

printf '\e[?2004h' # bracketed paste on, as the real CLI does
if [ -t 0 ]; then stty -icanon 2>/dev/null; trap 'stty icanon 2>/dev/null' EXIT; fi # no 4095-byte cooked line cap for big pastes
fire SessionStart SessionStart .source ".source=\"$source\""

pn=0
while printf '> ' && IFS= read -r line; do
  prompt=$line
  if [[ $line == $'\e[200~'* ]]; then # bracketed paste: lines up to the one ending ESC[201~; that NL is the Enter
    prompt=${line#$'\e[200~'}
    while [[ $prompt != *$'\e[201~' ]]; do
      IFS= read -r line || break
      prompt+=$'\n'$line
    done
    prompt=${prompt%$'\e[201~'}
  fi
  IFS=$' \t\n' read -d '' -ra words <<<"$prompt" || true
  [ "${words[0]:-}" = /exit ] && finish
  pn=$((pn + 1))
  printf '%s' "$prompt" >"$fhome/prompts/$sid.$pn" # exact bytes
  printf '%s\n' "${prompt//$'\n'/\\n}" >>"$hist"   # history: one line, newlines as \n
  if [ -n "$tfile" ]; then tline "$tfile" user "" "$prompt"; tline "$tfile" assistant "msg_${sid}_$pn" "ok"; fi
  fire UserPromptSubmit UserPromptSubmit .prompt ".prompt=\"$(jq -rn --arg l "$prompt" '$l|@json|.[1:-1]')\""
  stop=Stop esc=0
  for ((i = 0; i < ${#words[@]}; i++)); do
    case ${words[i]} in
      /tool) fire PostToolUse PostToolUse .tool_name ;;
      /perm) permission ;;
      /sub) subagent ;;
      /fail) stop=StopFailure ;;
      /notify)
        case ${words[i + 1]:-} in
          idle) fire Notification Notification-idle_prompt .notification_type ;;
          *) fire Notification Notification-permission_prompt .notification_type ;;
        esac
        ;;
      /esc) esc=1 ;;
      /long)
        if long_turn; then
          esc=1
          event interrupted
          fire Notification Notification-idle_prompt .notification_type # hypothetical, like /esc
        fi
        ;;
      /status) status ;;
      /compact) fire SessionStart SessionStart .source '.source="compact"' ;;
      /memsub) memsub ;;
    esac
  done
  if [ "$stop" = StopFailure ]; then fire StopFailure StopFailure .error
  elif [ "$esc" -eq 1 ]; then echo "interrupted"
  else fire Stop Stop .hook_event_name; fi
  echo "done"
done
finish
