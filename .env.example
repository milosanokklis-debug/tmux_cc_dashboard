CCDASH_VERSION=0.1.0
CLAUDE_CODE_VERSION=2.1.317
S6_OVERLAY_VERSION=3.2.0.3
BASIC_MEMORY_VERSION=1.0.0
# Agent kit cloned into /opt/agent-kit at build time (a full commit id, so the image is reproducible).
KIT_REPO=milosanokklis-debug/new_ai_setup
KIT_REF=81532ea0037fc2dd5ecc0837e24738de35d00460
# Public origin of the dashboard (the Cloudflare hostname), e.g. https://ccdash.example.com. Empty = SSH tunnel only.
CCDASH_ORIGIN=
# Seconds to wait for an approval before it is denied. Empty or unset = 120.
# CCDASH_APPROVAL_WAIT=120
